{
  "name": "sa-api",
  "version": "1.0.0",
  "description": "SuperAtom REST API — org management, user management, app permissions, auth",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:superadmin": "wrangler dev --var SUPERADMIN_HOST:superadmin.localhost --var SUPERADMIN_JWT_SECRET:$(openssl rand -hex 32)",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --config wrangler.dev.toml",
    "deploy:prod": "wrangler deploy --config wrangler.toml",
    "tail": "wrangler tail",
    "tail:dev": "wrangler tail --config wrangler.dev.toml",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:dev": "DATABASE_URL=$(grep -E '^DATABASE_URL=' .dev.vars | cut -d= -f2-) drizzle-kit migrate",
    "db:migrate:prod": "DATABASE_URL=$(grep -E '^DATABASE_URL=' .env | cut -d= -f2-) drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "superadmin": "tsx scripts/super-admins.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/node": "^25.2.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.22.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@xmldom/xmldom": "^0.8.15",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "jose": "^5.9.0",
    "xml-crypto": "^6.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
